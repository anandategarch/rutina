// Rutina - Personal Coach Digital
// Prisma schema: exercise library, weekly plan, workout sessions,
// readiness checks, personal records, coach messages, AI chat.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ EXERCISE LIBRARY ============

model Exercise {
  id          String       @id @default(cuid())
  name        String       @unique
  type        String // STRENGTH | CARDIO
  muscleGroup String // Dada, Punggung, Kaki, Bahu, Lengan, Core, Full Body
  equipment   String? // Barbell, Dumbbell, Cable, Mesin, Bodyweight
  tempo       String? // e.g. "3-1-1" (eccentric-pause-concentric)
  incrementKg Float        @default(2.5) // kenaikan beban terkecil utk progression
  cue         String? // form cue singkat
  planItems   PlanItem[]
  setLogs     SetLog[]
  records     PersonalRecord[]
}

// ============ WEEKLY PLAN TEMPLATE ============

model PlanItem {
  id                 String   @id @default(cuid())
  dayOfWeek          Int // 1 = Senin ... 7 = Minggu
  order              Int
  exerciseId         String
  exercise           Exercise @relation(fields: [exerciseId], references: [id])
  targetSets         Int      @default(3)
  targetMinReps      Int      @default(8)
  targetMaxReps      Int      @default(10)
  currentWeightKg    Float    @default(20) // working weight (berevolusi via progression)
  restSeconds        Int      @default(90)
  targetDistanceKm   Float? // utk CARDIO
  targetPaceSecPerKm Int? // detik per km, utk CARDIO
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([exerciseId, dayOfWeek])
}

// ============ WORKOUT SESSIONS & SET LOGS ============

model WorkoutSession {
  id             String   @id @default(cuid())
  date           DateTime // anchor jam 00:00 WIB pada hari sesi
  type           String // STRENGTH | CARDIO | RECOVERY
  title          String
  status         String   @default("COMPLETED") // COMPLETED | SKIPPED
  notes          String?
  readinessScore Int? // snapshot skor readiness saat sesi
  totalVolumeKg  Float    @default(0) // total beban x repetisi (strength)
  durationMin    Int?
  createdAt      DateTime @default(now())
  setLogs        SetLog[]
}

model SetLog {
  id          String         @id @default(cuid())
  sessionId   String
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])
  setNumber   Int
  weightKg    Float          @default(0)
  reps        Int            @default(0)
  rpe         Float? // rate of perceived exertion 1-10
  isWarmup    Boolean        @default(false)
  distanceKm  Float? // utk CARDIO
  durationSec Int? // utk CARDIO
  createdAt   DateTime       @default(now())
}

// ============ DAILY READINESS CHECK ============

model ReadinessCheck {
  id             String   @id @default(cuid())
  date           DateTime @unique // anchor jam 00:00 WIB
  sleepHours     Float
  soreness       Int // 1-5 (5 = sangat pegal)
  stress         Int // 1-5 (5 = sangat stres)
  energy         Int // 1-5 (5 = sangat bertenaga)
  score          Int // 0-100
  level          String // PRIME | GOOD | MODERATE | LOW
  recommendation String
  createdAt      DateTime @default(now())
}

// ============ PERSONAL RECORDS ============

model PersonalRecord {
  id           String   @id @default(cuid())
  exerciseId   String
  exercise     Exercise @relation(fields: [exerciseId], references: [id])
  weightKg     Float
  reps         Int
  estimated1RM Float
  date         DateTime
  createdAt    DateTime @default(now())
}

// ============ COACH MESSAGES (rule-based) ============

model CoachMessage {
  id        String   @id @default(cuid())
  type      String // CELEBRATION | WARNING | SUGGESTION | INFO | DELOAD
  title     String
  body      String
  severity  String   @default("info") // info | warning | success
  dedupeKey String? // utk hindari pesan duplikat
  date      DateTime
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ AI COACH CHAT ============

model ChatMessage {
  id        String   @id @default(cuid())
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())
}

// ============ PROFILE / APP STATE (single row) ============

model Profile {
  id                 String    @id @default(cuid())
  name               String    @default("Atlet")
  deloadUntil        DateTime? // aktif jika > hari ini
  weeklyGoalSessions Int       @default(4)
  createdAt          DateTime  @default(now())
}
