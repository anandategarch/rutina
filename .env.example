# Server-only values. Never use NEXT_PUBLIC_ for these secrets.
TURSO_DATABASE_URL=libsql://your-turso-db.turso.io
TURSO_AUTH_TOKEN=

# --- Konsep v2 (public/rutina.html) — BACA-SAJI terhadap database asli ---
# Sengaja memakai nama env berbeda dari TURSO_* agar route aplikasi lama
# (yang bisa menulis & menjaga skema) tidak terpicu oleh konsep.
# /api/rutina hanya menjalankan SELECT dan tidak pernah CREATE/UPDATE.
# PENTING: arahkan ke database LEGACY V1 (skema PascalCase: "Habit",
# "HabitLog", "Transaction", "AppSettings", dst.), BUKAN database V2.
# Bila terarah ke V2, semua permintaan gagal dan konsep jatuh ke snapshot.
RUTINA_TURSO_URL=libsql://your-legacy-v1-database.turso.io
RUTINA_TURSO_TOKEN=
