# Server-only values. Never use NEXT_PUBLIC_ for these secrets.
TURSO_DATABASE_URL=libsql://habit-tracker-v2-anandategarch.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

# --- Konsep v2 (public/rutina.html) — BACA-SAJA terhadap database asli ---
# Sengaja memakai nama env berbeda dari TURSO_* agar route aplikasi lama
# (yang bisa menulis & menjaga skema) tidak terpicu oleh konsep.
# /api/rutina hanya menjalankan SELECT dan tidak pernah CREATE/UPDATE.
RUTINA_TURSO_URL=libsql://your-database.turso.io
RUTINA_TURSO_TOKEN=
