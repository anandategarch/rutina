# Server-only — jangan pernah pakai NEXT_PUBLIC_ untuk nilai rahasia.

# Jembatan data /api/rutina (baca-tulis, idempoten via overlay).
# Tanpa nilai ini, API otomatis memakai SQLite lokal db/rutina-preview.db
# yang dibuat & diisi dari snapshot tertanam di public/rutina.html.
RUTINA_TURSO_URL=libsql://your-turso-db.turso.io
